// Тестовый скрипт 6.scr
// Системная информация

CLEAR
PRINTLN:=== SYSTEM INFO ===
PRINTLN:
PRINTLN:Micro OS v1.0
PRINTLN:ESP32-S3
PRINTLN:
PRINTLN:Heap free:
// Вывод свободной памяти
SYS:heap
PRINTLN:
PRINTLN:
PRINTLN:WiFi status:
SYS:wifi
PRINTLN:
PRINTLN:
PRINTLN:SD Card:
SYS:sd
PRINTLN:
PRINTLN:
PRINTLN:Press any key...
WAITKEY
HALT
