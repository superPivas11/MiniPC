// Тестовый скрипт 2.scr
// Рисование на экране

CLEAR
PRINTLN:Drawing test...

// Рисуем квадраты
RECT:10:30:20:20:65535
RECT:40:30:20:20:63488
RECT:70:30:20:20:2016
RECT:100:30:20:20:31

PRINTLN:
PRINTLN:RGB squares done!
DELAY:2000

// Рисуем линии
LINE:0:60:159:60:65535
LINE:0:80:159:80:65535

PRINTLN:Lines done!
DELAY:1000

// Круг
CIRCLE:80:100:15:63488

PRINTLN:Circle done!
PRINTLN:
PRINTLN:Press any key...
WAITKEY
CLEAR
HALT
