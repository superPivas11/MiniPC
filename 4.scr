// Тестовый скрипт 4.scr
// Простой калькулятор

CLEAR
PRINTLN:=== CALCULATOR ===
PRINTLN:
PRINTLN:Enter first num:
PRINTLN:(use keypad)
PRINTLN:

SET:a:0
SET:b:0
SET:result:0

// В реальности тут нужен ввод с клавиатуры
// Это демонстрация математики

SET:a:15
SET:b:7

PRINTLN:Testing: 15 + 7
MATH:ADD:result:15:7
GET:result
PRINTLN:

PRINTLN:Testing: 15 - 7
MATH:SUB:result:15:7
GET:result
PRINTLN:

PRINTLN:Testing: 15 * 7
MATH:MUL:result:15:7
GET:result
PRINTLN:

PRINTLN:Testing: 15 / 7
MATH:DIV:result:15:7
GET:result
PRINTLN:

PRINTLN:
PRINTLN:Done!
WAITKEY
HALT
